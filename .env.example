# =========================================================================
# SMART HOME ESP32 - ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================
# Salin berkas ini menjadi .env lalu isi kredensial Supabase Anda:
#   copy .env.example .env (Windows) atau cp .env.example .env (Linux/Mac)
# =========================================================================

# 1. Kredensial Supabase (Wajib untuk Mode Supabase Realtime)
# Dapatkan dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Mode Operasi Bawaan Aplikasi
# Pilihan: 'supabase' (Cloud Realtime), 'simulation' (Mock Virtual), 'esp32' (Direct LAN)
DEFAULT_APP_MODE=supabase

# 3. Alamat IP ESP32 Fisik (Opsional, jika menggunakan Direct LAN)
# Contoh: 192.168.1.100 atau biarkan kosong jika belum terhubung
ESP32_IP=
